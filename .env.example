# Config do app — TODAS por variável de ambiente. Nada de valor real aqui.

# Caminho do arquivo SQLite. Obrigatória: sem ela o app não sobe.
APP_DB_PATH=./data/nfe.db

# Classificação por LLM (opcional, opt-in). A base determinística roda sem nada disso.
# OLLAMA_URL presente LIGA o LLM; comentada, ele fica desligado (o padrão).
# Ligado, OLLAMA_MODELO e LLM_LIMIAR são obrigatórias e não têm valor padrão:
# configuração pela metade impede o app de subir.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODELO=
# LLM_LIMIAR=
